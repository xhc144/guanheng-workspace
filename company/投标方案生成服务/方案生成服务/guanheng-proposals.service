[Unit]
Description=Guanheng paid proposal generator
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/guanheng-proposals
EnvironmentFile=/home/ubuntu/.config/personal-site/deepseek.env
EnvironmentFile=-/etc/guanheng-proposals/wechat.env
ExecStart=/usr/bin/node /opt/guanheng-proposals/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/guanheng-proposals
UMask=0077
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
