<html>
<head><title>PMS 验收</title>
<hta:application id="pms" border="dialog" innerborder="no" caption="yes" maximizebutton="no" minimizebutton="no" sysmenu="yes" scroll="no" contextmenu="no" selection="no"/>
<style>body{font-family:Consolas;background:#1e1e1e;color:#d4d4d4;padding:16px;margin:0}
h2{color:#569cd6}pre{margin:0;white-space:pre-wrap}.ok{color:#4ec9b0}.warn{color:#dcdcaa}.err{color:#f44747}</style></head>
<body>
<h2>PMS v1.0.0 验收 (完整完善版)</h2>
<pre id="out">RUNNING...</pre>
<script>
var wsh=new ActiveXObject("WScript.Shell");
var fso=new ActiveXObject("Scripting.FileSystemObject");
var root=fso.GetParentFolderName(window.location.pathname.replace(/^\/*/,"").replace(/\/*$/,""));
var out="";
try{
  var py=wsh.Exec('cmd /c "cd /d '+root+' && python run_verify.py 2>&1"');
  out=py.StdOut.ReadAll();
  if(out=="")out=py.StdErr.ReadAll();
  if(out=="")out="DONE (exit "+py.ExitCode+")";
}catch(e){out="ERROR: "+e.message+"\n\n双击 verify.bat 或在 cmd 中运行 python run_verify.py"}
document.getElementById("out").innerHTML=out.replace(/&/g,"&amp;").replace(/</g,"&lt;");
</script></body></html>
