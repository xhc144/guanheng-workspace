### 综合项目管理系统 API 测试集 v1.0.0
### 使用 VS Code REST Client 插件或 IntelliJ HTTP Client

@baseUrl = http://localhost:8000/api
@token = {{login.response.body.access_token}}

# ===== 认证 =====

### 登录
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"username": "admin", "password": "Admin@123456"}

### 获取当前用户
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### 健康检查（无需认证）
GET {{baseUrl}}/health

### 系统状态
GET {{baseUrl}}/status
Authorization: Bearer {{token}}

# ===== 客户 =====

### 客户列表
GET {{baseUrl}}/customers?search=深圳
Authorization: Bearer {{token}}

### 创建客户
POST {{baseUrl}}/customers
Authorization: Bearer {{token}}
Content-Type: application/json

{"name": "测试客户", "short_name": "测试", "credit_level": "A"}

# ===== 项目 =====

### 项目列表（分页）
GET {{baseUrl}}/projects?page=1&page_size=10&status=active
Authorization: Bearer {{token}}

### 创建项目
POST {{baseUrl}}/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{"code": "PRJ-TEST-001", "name": "测试项目", "customer_id": "c001", "manager_id": "test_admin"}

### 项目详情
GET {{baseUrl}}/projects/p001
Authorization: Bearer {{token}}

# ===== 任务 =====

### 任务列表
GET {{baseUrl}}/tasks?project_id=p001
Authorization: Bearer {{token}}

### 创建任务
POST {{baseUrl}}/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{"project_id": "p001", "title": "测试任务", "weight": 2, "assignee_id": "u004"}

### 更新任务状态
PUT {{baseUrl}}/tasks/t001
Authorization: Bearer {{token}}
Content-Type: application/json

{"status": "done"}

### 删除任务
DELETE {{baseUrl}}/tasks/t004
Authorization: Bearer {{token}}

# ===== 合同与财务 =====

### 合同列表
GET {{baseUrl}}/contracts?project_id=p001
Authorization: Bearer {{token}}

### 回款列表
GET {{baseUrl}}/receipts?project_id=p001
Authorization: Bearer {{token}}

### 登记回款
POST {{baseUrl}}/receipts
Authorization: Bearer {{token}}
Content-Type: application/json

{"project_id": "p001", "amount": 50000, "received_date": "2024-06-15T00:00:00", "payer": "测试客户", "bank_ref": "BNK-TEST-001"}

### 确认回款（需要 finance 角色）
PUT {{baseUrl}}/receipts/rcpt001/confirm
Authorization: Bearer {{token}}

### 项目回款统计
GET {{baseUrl}}/receipts/project/p001/stats
Authorization: Bearer {{token}}

# ===== 风险 =====

### 风险列表
GET {{baseUrl}}/risks?project_id=p001
Authorization: Bearer {{token}}

### 创建风险
POST {{baseUrl}}/risks
Authorization: Bearer {{token}}
Content-Type: application/json

{"project_id": "p001", "title": "测试风险", "probability": "high", "impact": "medium"}

### 风险跟进
POST {{baseUrl}}/risks/r001/follow-up
Authorization: Bearer {{token}}
Content-Type: application/json

{"risk_id": "r001", "content": "已完成人员备份"}

# ===== 看板与工作台 =====

### 高管驾驶舱
GET {{baseUrl}}/dashboard
Authorization: Bearer {{token}}

### 个人工作台
GET {{baseUrl}}/workbench
Authorization: Bearer {{token}}

# ===== 审批 =====

### 审批模板
GET {{baseUrl}}/approvals/templates
Authorization: Bearer {{token}}

### 我的待审批
GET {{baseUrl}}/approvals/my-pending
Authorization: Bearer {{token}}

# ===== 搜索与导出 =====

### 全局搜索
GET {{baseUrl}}/search?q=ERP
Authorization: Bearer {{token}}

### 导出项目
GET {{baseUrl}}/export/projects
Authorization: Bearer {{token}}

### 导出回款
GET {{baseUrl}}/export/receipts?project_id=p001
Authorization: Bearer {{token}}

# ===== 通知与审计 =====

### 通知列表
GET {{baseUrl}}/notifications?unread_only=true
Authorization: Bearer {{token}}

### 审计日志
GET {{baseUrl}}/audit-logs
Authorization: Bearer {{token}}

# ===== 新增端点 =====

### 里程碑列表
GET {{baseUrl}}/milestones?project_id=p001
Authorization: Bearer {{token}}

### 问题列表
GET {{baseUrl}}/issues?project_id=p001
Authorization: Bearer {{token}}

### 预算执行报告
GET {{baseUrl}}/reports/budget-vs-actual
Authorization: Bearer {{token}}

### 导出合同
GET {{baseUrl}}/export/contracts
Authorization: Bearer {{token}}

### 导出客户
GET {{baseUrl}}/export/customers
Authorization: Bearer {{token}}

### 导出回款账龄
GET {{baseUrl}}/export/aging
Authorization: Bearer {{token}}

### 文件列表
GET {{baseUrl}}/files/list?project_id=p001
Authorization: Bearer {{token}}

### 活动日志
GET {{baseUrl}}/activities?project_id=p001
Authorization: Bearer {{token}}

### 修改密码
PUT {{baseUrl}}/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{"old_password": "admin123", "new_password": "newpass123"}
